#!/bin/sh

set -e

GIT="$(
    which -a "git" |
    grep -v "$(readlink -f "$(dirname "$0")")" |
    head -n 1
)"

DONE="" N="$#" SKIP=0
while [ "$N" -gt 0 ]
do
    A="$1"
    shift
    N="$((N - 1))"
    if [ -n "$DONE" ]
    then :
    elif [ "$SKIP" -eq 1 ]
    then SKIP=0
    else
        case "$A" in
            "--attr-source") SKIP=1;;
            "--attr-source="*) ;;
            "--bare") ;;
            "--config-env") SKIP=1;;
            "--config-env="*) ;;
            "--exec-path") ;;
            "--exec-path="*) ;;
            "--git-dir") SKIP=1;;
            "--git-dir="*) ;;
            "--glob-pathspecs") ;;
            "--help") ;;
            "--html-path") ;;
            "--icase-pathspecs") ;;
            "--info-path") ;;
            "--list-cmds") SKIP=1;;
            "--list-cmds="*) ;;
            "--literal-pathspecs") ;;
            "--man-path") ;;
            "--namespace") SKIP=1;;
            "--namespace="*) ;;
            "--no-advice") ;;
            "--no-lazy-fetch") ;;
            "--no-optional-locks") ;;
            "--no-pager") ;;
            "--no-replace-objects") ;;
            "--noglob-pathspecs") ;;
            "--paginate") ;;
            "--version") ;;
            "--work-tree") SKIP=1;;
            "--work-tree="*) ;;
            "-C") SKIP=1;;
            "-c") SKIP=1;;
            "-C"*) ;;
            "-c"*) ;;
            "-h") ;;
            "-p") ;;
            "-P") ;;
            "-v") ;;
            "-"*) ;;
            "commit") A="commit-verified" DONE=1;;
            "revert") A="revert-verified" DONE=1;;
            *) DONE=1;;
        esac
    fi
    set -- "$@" "$A"
done
exec "$GIT" "$@"
