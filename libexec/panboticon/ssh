#!/bin/sh

set -e

usage() {
    printf "Usage: panboticon ssh [-b] [\e[4m...\e[0m] [\e[4mname\e[0m] [\e[4m...\e[0m]\n" >&2
    printf "  -b    SSH as the bot user instead of the human user\n" >&2
    printf "  \e[4mname\e[0m  name of the Panboticon instance to SSH to (inferred from \`panboticon boxen\` if not given and there's only one)\n" >&2
    printf "  \e[4m...\e[0m   additional options from ssh(1), including optionally ending with a command and arguments\n" >&2
    exit "$1"
}

U="$PANBOTICON_HUMAN_USER"
if [ "$(basename "$0")" = "$1" ]
then shift
fi
while [ "$#" -gt 0 ]
do
    case "$1" in

        "-b"|"--bot") U="$PANBOTICON_BOT_USER" shift;;

        "-h"|"--help") usage 0;;

        *) break;;

    esac
done

. "$PANBOTICON_LIB/aws.sh"

SSH="$(
    which -a "ssh" |
    grep -v "$PANBOTICON_LIBEXEC" |
    head -n 1
)"
if [ "$TERM" = "xterm-ghostty" ]
then export TERM="xterm-256color"
fi

if [ -z "$1" ]
then
    boxen >"$TMP/boxen.txt"
    if [ "$(wc -l <"$TMP/boxen.txt")" -ne 1 ]
    then usage 1
    fi
    set -- "$(cat "$TMP/boxen.txt")"
fi

NAME=""
for A in "$@"
do
    if [ -f "$HOME/.panboticon/etc/ssh_config/$A.ssh_config" ]
    then
        NAME="$A"
        break
    fi
done
if [ -z "$NAME" ]
then
    echo "Could not find the name of a Panboticon instance with an SSH configuration amonst the arguments: $*" >&2
    exit 1
fi

aws_ec2_instance_connect "$NAME" "$U"

"$SSH" -F "$HOME/.panboticon/etc/ssh_config/$NAME.ssh_config" -l "$U" "$@"
