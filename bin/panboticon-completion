#!/bin/sh

set -e

PANBOTICON_PREFIX="$(cd "$(dirname "$0")/.." && pwd)"
PANBOTICON_LIB="$PANBOTICON_PREFIX/lib/panboticon"

usage() {
    printf "Usage: panboticon-completion [-s \e[4mshell\e[0m]\n" >&2
    printf "  -s \e[4mshell\e[0m  shell dialect to complete (\"bash\" or \"zsh\"; defaults to \$SHELL)\n" >&2
    exit "$1"
}

DIALECT="$(basename "$SHELL")"
while [ "$#" -gt 0 ]
do
    case "$1" in

        "-s"|"--sh"|"--shell") DIALECT="$2" shift 2;;
        "-s"*) DIALECT="$(echo "$1" | cut -c"3-")" shift;;
        "--sh="*|"--shell="*) DIALECT="$(echo "$1" | cut -d"=" -f"2-")" shift;;

        "-h"|"--help") usage 0;;

        *) break;;

    esac
done

cat "$PANBOTICON_LIB/completion.$DIALECT" # TODO No, tell them to source it directly from the Panboticon prefix or the ls won't work.
