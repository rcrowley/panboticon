#!/bin/sh

set -e

GH="$(
    which -a "gh" |
    grep -v "$(readlink -f "$(dirname "$0")")" |
    head -n 1
)"

ORG="$(
    git remote get-url "origin" 2>"/dev/null" |
    sed -E -n 's#^(https://github\.com/|git@github\.com:)([^/]+)/.*$#\2#p'
)"
if [ -z "$ORG" -a -f "$HOME/.panboticon/etc/github-app/installations.json" ]
then ORG="$(jq -e -r '.[] | select(.DEFAULT).ORGANIZATION' <"$HOME/.panboticon/etc/github-app/installations.json")"
fi
[ "$ORG" ]

export GH_TOKEN="$(
    printf "protocol=https\nhost=github.com\npath=%s/x\nusername=x-access-token\n\n" "$ORG" |
    GIT_TERMINAL_PROMPT=0 git credential fill 2>"/dev/null" |
    sed -n 's/^password=//p'
)"

exec "$GH" "$@"
